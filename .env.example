# Copie para .env e ajuste. Nunca commite o .env.
#
# Compose (spec 013, T4): estas duas vão em docker/.env (lido pelo `docker compose -f
# docker/compose.yml`) ou no ambiente. São obrigatórias. Cada stack no mesmo host precisa de uma
# subnet própria. O proxy usa o último endereço útil dela (.14 numa /28): o Docker dá os
# endereços dinâmicos de baixo para cima, e a API, criada antes, fica com o .2. O .1 é o gateway
# da bridge, que não é confiável.
# Faixa do projeto: 10.231.0.0/16 (as suítes e2e usam 10.231.10.0/28 a 10.231.13.0/28).
SGS_BORDA_SUBNET=10.231.1.0/28
SGS_BORDA_PROXY_IP=10.231.1.14

APP_ENV=dev
DEBUG=false
LOG_LEVEL=INFO
# Origens separadas por vírgula, no formato esquema://host[:porta]
CORS_ORIGINS=https://localhost:3000

# A API conecta como sgs_api, membro do papel sgs_app (sem UPDATE/DELETE em audit_log).
DATABASE_URL=postgresql+asyncpg://sgs_api:sgs_api@db:5432/sgs
# Dono do banco, usado só pelas migrações (automáticas na subida em dev).
DATABASE_MIGRATION_URL=postgresql+asyncpg://sgs:sgs@db:5432/sgs
# disable | require | verify-full (prod exige verify-full; CA em DATABASE_SSL_ROOT_CERT).
# O compose já usa verify-full com a CA gerada pelo serviço db-certs (spec 011, R10.3).
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_ROOT_CERT=/certs/ca.crt

# Chaves de assinatura JWT (ES256): lista JSON de objetos {"kid","pem"}; a primeira assina e
# todas vão para o JWKS. Gere com `uv run python -m src.tools.jwt_keys --output secrets/jwt-keys.json`.
# Aponte o arquivo em JWT_PRIVATE_KEYS_FILE ou ponha o JSON em JWT_PRIVATE_KEYS (só uma das duas).
# Em prod, kid com "troque", "exemplo", "example" ou "changeme" é recusado.
JWT_PRIVATE_KEYS_FILE=/run/secrets/jwt-keys.json

# Chaves de criptografia de campo (AES-256-GCM, segredo TOTP; spec 002, T5): objeto JSON
# {"versão":"32 bytes em base64"}. Gere com
# `uv run python -m src.tools.crypto_keys --output secrets/crypto-keys.json` e aponte o arquivo
# em CRYPTO_KEYS_FILE, ou ponha o JSON em CRYPTO_KEYS (só uma das duas). A chave de zeros abaixo
# é só de exemplo e é recusada em prod.
CRYPTO_KEYS_FILE=/run/secrets/crypto-keys.json
# CRYPTO_KEYS={"1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
CRYPTO_ACTIVE_KEY=1

# TOTP obrigatório para contas locais (spec 002). Só em dev pode ficar false, para testes manuais.
MFA_OBRIGATORIO=true

# LDAP, OIDC e S3: specs 004 e 005, ainda não implementadas (variáveis reservadas).
LDAP_URL=ldaps://ldap:636
LDAP_BIND_DN=cn=sgs-sync,ou=servicos,dc=recife,dc=pe,dc=gov,dc=br
LDAP_BIND_PASSWORD=troque
LDAP_USER_BASE=ou=pessoas,dc=recife,dc=pe,dc=gov,dc=br
LDAP_GROUP_BASE=ou=grupos,dc=recife,dc=pe,dc=gov,dc=br
LDAP_CA_FILE=/run/secrets/ldap-ca.pem

OIDC_ISSUER=https://keycloak.localhost/realms/sgs
OIDC_CLIENT_ID=sgs-api
OIDC_CLIENT_SECRET=troque
OIDC_GROUPS_CLAIM=groups

S3_BUCKET=sgs-relatorios
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://s3:8333
S3_ASSUME_ROLE_ARN=
S3_EXTERNAL_ID=
S3_SSE=AES256
